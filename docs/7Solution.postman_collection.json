      "name": "localhost:8080/api/v1/auth/register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();\n\nif (pm.response.code === 201 && res.id) {\n    pm.collectionVariables.set(\"userId\", res.id);\n}\n\npm.test(\"status 201\", () => pm.response.to.have.status(201));\npm.test(\"no password leaked\", () => {\n    pm.expect(pm.response.json()).to.not.have.property(\"password\");\n});\npm.test(\"email normalized to lowercase\", () => {\n    const email = pm.response.json().email;\n    pm.expect(email).to.equal(email.toLowerCase());\n});"
            ]
          }
        }
      ],
